{
    "$schema": "https://json-schema.org/draft-07/schema",
    "$id": "https://example.com/backup.schema",
    "version": 1.0,
    "release": "2025/05/24",
    "author": "Chao-Jen Huang (ephoton)",
    "title": "Database Backup",
    "description": "A backup of the database at a specific date and time.",
    "type": "object",
    "properties": {
        "$schema": {
            "description": "The schema of the database backup configuration.",
            "type": "string",
            "format": "uri-reference"
        },
        "version": {
            "description": "Define the database backup file format",
            "type": "number",
            "default": 1.0,
            "const": 1.0
        },
        "release": {
            "description": "The release date of the configuration. Date format is \"yyyy/mm/dd\".",
            "type": "string",
            "pattern": "^(?:19|2[01])[0-9]{2}/(?:0[1-9]|1[0-2])/(?:0[1-9]|[12][0-9]|3[01])$"
        },
        "author": {
            "description": "The author of the configuration.",
            "type": "string"
        },
        "debugMode": {
            "description": "Enable debug mode. The default value is false.",
            "type": "boolean",
            "default": false
        },
        "backup": {
            "type": "object",
            "properties": {
                "design": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "library": {
                                "type": "string"
                            },
                            "cell": {
                                "$ref": "#/definitions/arrayString"
                            },
                            "view": {
                                "type": "string",
                                "enum": [ "schematic", "layout" ],
                                "default": "schematic"
                            },
                            "testbenches": {
                                "$ref": "#/definitions/arrayString"
                            },
                            "backupToLibrary": {
                                "type": "boolean",
                                "default": false
                            },
                            "prefix": {
                                "type": "string"
                            }
                        },
                        "additionalProperties": false,
                        "required": [
                            "library",
                            "cell"
                        ]
                    }
                },
                "ignore": {
                    "$ref": "#/definitions/list"
                },
                "prohibit": {
                    "$ref": "#/definitions/list"
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false,
    "definitions": {
        "list": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "library": {
                        "$ref": "#/definitions/arrayString"
                    },
                    "cell": {
                        "$ref": "#/definitions/arrayString"
                    }
                },
                "additionalProperties": false,
                "oneOf": [
                    {
                        "required": [ "library" ]
                    },
                    {
                        "required": [ "cell" ]
                    }
                ]
            }
        },
        "arrayString": {
            "type": [ "array", "string" ],
            "items": {
                "type": "string"
            },
            "minimum": 1
        }
    }
}