{
    "$schema": "https://json-schema.org/draft-07/schema",
    "$id": "https://example.com/cdfTermOrder.schema",
    "version": 1.0,
    "release": "2026/02/05",
    "author": "Chao-Jen Huang (ephoton)",
    "title": "CDF Terminal Order Update",
    "description": "Configuration for updating CDF terminal order with hierarchy support.",
    "type": "object",
    "properties": {
        "$schema": {
            "description": "The schema of the CDF terminal order configuration.",
            "type": "string",
            "format": "uri-reference"
        },
        "version": {
            "description": "Define the CDF terminal order configuration file format",
            "type": "number",
            "default": 1.0,
            "const": 1.0
        },
        "release": {
            "description": "The release date of the configuration. Date format is \"yyyy/mm/dd\".",
            "type": "string",
            "pattern": "^(?:19|2[01])[0-9]{2}/(?:0[1-9]|1[0-2])/(?:0[1-9]|[12][0-9]|3[01])$"
        },
        "author": {
            "description": "The author of the configuration.",
            "type": "string"
        },
        "debugMode": {
            "description": "Enable debug mode. The default value is false.",
            "type": "boolean",
            "default": false
        },
        "cdfTermOrder": {
            "type": "object",
            "properties": {
                "design": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "library": {
                                "type": "string",
                                "description": "Library name containing the cells to update"
                            },
                            "cell": {
                                "$ref": "#/definitions/arrayString",
                                "description": "Cell name(s) to update CDF terminal order. Can be a single string or array of strings."
                            },
                            "view": {
                                "type": "string",
                                "enum": [ "schematic", "symbol" ],
                                "description": "View name to process. If not specified, auto-detects from schematic or symbol.",
                                "default": null
                            },
                            "hierarchy": {
                                "type": "boolean",
                                "description": "Enable hierarchy processing to update all hierarchical cells. Default is false.",
                                "default": false
                            }
                        },
                        "additionalProperties": false,
                        "required": [
                            "library",
                            "cell"
                        ]
                    }
                },
                "ignore": {
                    "$ref": "#/definitions/list",
                    "description": "List of libraries or cells to ignore during hierarchy processing"
                },
                "prohibit": {
                    "$ref": "#/definitions/list",
                    "description": "List of libraries or cells to prohibit during hierarchy processing"
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false,
    "definitions": {
        "list": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "library": {
                        "$ref": "#/definitions/arrayString",
                        "description": "Library name(s) to match. Can be a single string or array of strings."
                    },
                    "cell": {
                        "$ref": "#/definitions/arrayString",
                        "description": "Cell name(s) to match. Can be a single string or array of strings."
                    }
                },
                "additionalProperties": false,
                "anyOf": [
                    {
                        "required": [ "library" ]
                    },
                    {
                        "required": [ "cell" ]
                    }
                ]
            }
        },
        "arrayString": {
            "type": [ "array", "string" ],
            "items": {
                "type": "string"
            },
            "minimum": 1
        }
    }
}
