{
    "$schema": "https://json-schema.org/draft-07/schema",
    "$id": "https://example.com/cellduplicate.schema",
    "version": 1.0,
    "release": "2025/05/15",
    "author": "Chao-Jen Huang (ephoton)",
    "title": "Cell Duplicate",
    "type": "object",
    "properties": {
        "$schema": {
            "description": "The schema of the cell duplicate configuration.",
            "type": "string",
            "format": "uri-reference"
        },
        "version": {
            "description": "Define the duplicate cell configure format",
            "type": "number",
            "default": 1.0,
            "const": 1.0
        },
        "release": {
            "description": "The release date of the configuration. Date format is \"yyyy/mm/dd\".",
            "type": "string",
            "pattern": "^(?:19|2[01])[0-9]{2}/(?:0[1-9]|1[0-2])/(?:0[1-9]|[12][0-9]|3[01])$"
        },
        "author": {
            "description": "The author of the configuration.",
            "type": "string"
        },
        "debugMode": {
            "description": "Enable debug mode. The default value is false.",
            "type": "boolean",
            "default": false
        },
        "duplicate": {
            "type": "object",
            "properties": {
                "overwrite": {
                    "description": "Set the default overwrite rule. If not set, overwrite will not be performed.",
                    "type": "boolean",
                    "default": false
                },
                "copiedViewTypes": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "copiedViewNames": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "removeViews": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "expandFlag": {
                    "$ref": "#/definitions/expandFlag"
                },
                "namespace": {
                    "$ref": "#/definitions/namespace"
                },
                "techfile": {
                    "description": "Specifies the technology file for the library. If not specified, the target library will use the source library's technology file.",
                    "type": "string"
                },
                "database": {
                    "type": [ "array", "object" ],
                    "$ref": "#/definitions/database",
                    "items": {
                        "type": "object",
                        "$ref": "#/definitions/database"
                    }
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false,
    "required": [
        "version",
        "release",
        "author",
        "duplicate"
    ],
    "definitions": {
        "database": {
            "properties": {
                "overwrite": {
                    "description": "Set the overwrite rule for this database. If not set, overwrite will not be performed.",
                    "type": "boolean",
                    "default": false
                },
                "copiedViewTypes": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "copiedViewNames": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "removeViews": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "expandFlag": {
                    "$ref": "#/definitions/expandFlag"
                },
                "namespace": {
                    "$ref": "#/definitions/namespace"
                },
                "techfile": {
                    "description": "Specifies the technology file for the library. If not specified, the target library will use the source library's technology file.",
                    "type": "string"
                },
                "library": {
                    "$ref": "#/definitions/sourceTargetLibrary",
                    "type": [ "array", "object", "string" ],
                    "items": {
                        "type": "string",
                        "minItems": 1,
                        "maxItems": 2
                    }
                },
                "cells": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/sourceTargetCell",
                        "type": [ "array", "object", "string" ],
                        "items": {
                            "type": "string"
                        },
                        "minItems": 2,
                        "maxItems": 2
                    }
                }
            },
            "additionalProperties": false,
            "required": [
                "library",
                "cells"
            ]
        },
        "library": {
            "type": "object",
            "properties": {
                
            },
            "additionalProperties": false,
            "required": [
                "library",
                "cell"
            ]
        },
        "sourceTargetLibrary": {
            "properties": {
                "source": {
                    "type": "string"
                },
                "target": {
                    "type": "string"
                }
            },
            "required": [
                "source",
                "target"
            ],
            "additionalProperties": false
        },
        "sourceTargetCell": {
            "properties": {
                "source": {
                    "type": "string"
                },
                "target": {
                    "type": "string"
                },
                "enable": {
                    "type": "boolean",
                    "default": true
                },
                "overwrite": {
                    "type": "boolean",
                    "default": false
                }
            },
            "required": [
                "source",
                "target"
            ],
            "additionalProperties": false
        },
        "expandFlag": {
            "description": "Expand the flat options. The default value is expand all.",
            "type": "string",
            "enum": [
                "all",
                "comanaged"
            ],
            "default": "all"
        },
        "namespace": {
            "description": "The namespace of the library. If not specified, the default namespace CDBA will be used.",
            "type": "string",
            "enum": [
                "VHDL",
                "Verilog",
                "Verilog-A",
                "CDBA",
                "Concept",
                "Library",
                "LibraryUnix",
                "LibraryNT"
            ],
            "default": "CDBA"
        }
    }
}