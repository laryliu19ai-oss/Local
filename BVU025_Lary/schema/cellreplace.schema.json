{
    "$schema": "https://json-schema.org/draft-07/schema",
    "$id": "https://example.com/cellreplace.schema",
    "version": 1.0,
    "release": "2025/05/08",
    "author": "Chao-Jen Huang (ephoton)",
    "title": "Cellview Replacement",
    "type": "object",
    "properties": {
        "$schema": {
            "description": "The schema of the cellview replacement configuration.",
            "type": "string",
            "format": "uri-reference"
        },
        "version": {
            "description": "Define the replace cell config format",
            "type": "number",
            "default": 1.0,
            "const": 1.0
        },
        "release": {
            "description": "The release date of the configuration. Date format is \"yyyy/mm/dd\".",
            "type": "string",
            "pattern": "^(?:19|2[01])[0-9]{2}/(?:0[1-9]|1[0-2])/(?:0[1-9]|[12][0-9]|3[01])$"
        },
        "author": {
            "description": "The author of the configuration.",
            "type": "string"
        },
        "debugMode": {
            "description": "Enable debug mode. The default value is false.",
            "type": "boolean",
            "default": false
        },
        "replace": {
            "type": "object",
            "properties": {
                "logfile": {
                    "type": "object",
                    "properties": {
                        "enable": {
                            "description": "Enable the log file or not.",
                            "type": "boolean",
                            "default": true
                        },
                        "filename": {
                            "description": "The log file name.",
                            "type": "string"
                        }
                    },
                    "additionalProperties": false
                },
                "rule": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "library": {
                                "type": [ "string", "object" ],
                                "properties": {
                                    "source": {
                                        "type": "string"
                                    },
                                    "target": {
                                        "type": "string"
                                    }
                                },
                                "additionalProperties": false
                            },
                            "cell": {
                                "type": "array",
                                "items": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    },
                                    "minItems": 2,
                                    "maxItems": 2
                                },
                                "minItems": 1
                            },
                            "view": {
                                "type": "array",
                                "items": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    },
                                    "minItems": 2,
                                    "maxItems": 2
                                },
                                "minItems": 1
                            },
                            "cdf": {
                                "type": "object",
                                "properties": {
                                    "default": {
                                        "type": [ "string", "array" ],
                                        "items": {
                                            "type": "string"
                                        },
                                        "minItems": 1
                                    },
                                    "callback": {
                                        "type": [ "string", "array" ],
                                        "items": {
                                            "type": "string"
                                        },
                                        "minItems": 1
                                    },
                                    "remove": {
                                        "type": [ "string", "array" ],
                                        "items": {
                                            "type": "string"
                                        },
                                        "minItems": 1
                                    }
                                }
                            }
                        },
                        "required": [
                            "library"
                        ],
                        "additionalProperties": false
                    },
                    "minItems": 1
                },
                "ignore": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "library": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "minItems": 1
                            },
                            "cell": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "minItems": 1
                            }
                        },
                        "additionalProperties": false,
                        "oneOf": [
                            {
                                "required": [
                                    "library"
                                ]
                            },
                            {
                                "required": [
                                    "cell"
                                ]
                            }
                        ]
                    },
                    "minItems": 1
                },
                "design": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "library": {
                                "description": "The library name to be replaced.",
                                "type": "string"
                            },
                            "cell": {
                                "description": "The cell name to be replaced.",
                                "type": [ "array", "string" ],
                                "items": {
                                    "type": "string"
                                },
                                "minItems": 1
                            },
                            "hierarchy": {
                                "description": "Replace the cellview with hierarchy or not.",
                                "type": "boolean",
                                "default": true
                            }
                        },
                        "additionalProperties": false,
                        "required": [
                            "library"
                        ]
                    }
                }
            },
            "additionalProperties": false,
            "required": [
                "rule"
            ]
        }
    },
    "additionalProperties": false
}