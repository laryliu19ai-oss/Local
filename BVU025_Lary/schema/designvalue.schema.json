{
    "$schema": "https://json-schema.org/draft-07/schema",
    "$id": "https://example.com/backup.schema",
    "version": 1.0,
    "release": "2025/11/27",
    "author": "Chao-Jen Huang (ephoton)",
    "title": "Design Value Settings",
    "type": "object",
    "properties": {
        "$schema": {
            "description": "The schema of the design value settings.",
            "type": "string",
            "format": "uri-reference"
        },
        "version": {
            "description": "Define the design value settings file format",
            "type": "number",
            "default": 1.0,
            "const": 1.0
        },
        "release": {
            "description": "The release date of the configuration. Date format is \"yyyy/mm/dd\".",
            "type": "string",
            "pattern": "^(?:19|2[01])[0-9]{2}/(?:0[1-9]|1[0-2])/(?:0[1-9]|[12][0-9]|3[01])$"
        },
        "author": {
            "description": "The author of the configuration.",
            "type": "string"
        },
        "debugMode": {
            "description": "Enable debug mode. The default value is false.",
            "type": "boolean",
            "default": false
        },
        "designValue": {
            "type": "object",
            "properties": {
                "design": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "library": {
                                "oneOf": [
                                    {
                                        "type": "string"
                                    },
                                    {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                ]
                            },
                            "cell": {
                                "oneOf": [
                                    {
                                        "type": "string"
                                    },
                                    {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                ]
                            },
                            "view": {
                                "description": "View name or list of view names. Common values are \"schematic\" and \"layout\", but other view names are also accepted.",
                                "oneOf": [
                                    {
                                        "type": "string"
                                    },
                                    {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                ]
                            },
                            "viewType": {
                                "description": "View type specification. Supported types are \"schematic\" and \"maskLayout\".",
                                "oneOf": [
                                    {
                                        "type": "string",
                                        "enum": [ "schematic", "maskLayout" ]
                                    },
                                    {
                                        "type": "array",
                                        "items": {
                                            "type": "string",
                                            "enum": [ "schematic", "maskLayout" ]
                                        }
                                    }
                                ]
                            },
                            "mode": {
                                "type": "string",
                                "enum": [ "glob", "regex" ],
                                "default": "glob"
                            },
                            "hierarchy": {
                                "type": "boolean",
                                "default": false
                            }
                        },
                        "required": [ "library" ],
                        "additionalProperties": false
                    }
                },
                "ignore": {
                    "description": "Filter configuration to ignore specific libraries and cells during hierarchy processing",
                    "$ref": "#/definitions/filterList"
                },
                "prohibit": {
                    "description": "Filter configuration to prohibit specific libraries and cells during hierarchy processing",
                    "$ref": "#/definitions/filterList"
                },
                "settings": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "instance": {
                                "type": "object",
                                "properties": {
                                    "library": {
                                        "oneOf": [
                                            {
                                                "type": "string"
                                            },
                                            {
                                                "type": "array",
                                                "items": {
                                                    "type": "string"
                                                }
                                            }
                                        ]
                                    },
                                    "cell": {
                                        "oneOf": [
                                            {
                                                "type": "string"
                                            },
                                            {
                                                "type": "array",
                                                "items": {
                                                    "type": "string"
                                                }
                                            }
                                        ]
                                    },
                                    "view": {
                                        "oneOf": [
                                            {
                                                "type": "string"
                                            },
                                            {
                                                "type": "array",
                                                "items": {
                                                    "type": "string"
                                                }
                                            }
                                        ]
                                    },
                                    "mode": {
                                        "type": "string",
                                        "enum": [ "glob", "regex" ],
                                        "default": "glob"
                                    },
                                    "ignoreInstanceNameRule": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "additionalProperties": false
                            },
                            "parameters": {
                                "type": "object"
                            }
                        },
                        "required": [ "parameters" ],
                        "additionalProperties": false
                    }
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false,
    "definitions": {
        "arrayString": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "filterList": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "library": {
                        "$ref": "#/definitions/arrayString"
                    },
                    "cell": {
                        "$ref": "#/definitions/arrayString"
                    },
                    "exclude": {
                        "$ref": "#/definitions/arrayString"
                    }
                },
                "additionalProperties": false
            }
        }
    }
}