{
    "$schema": "https://json-schema.org/draft-07/schema",
    "$id": "https://example.com/evaluation.schema",
    "version": 1.0,
    "release": "2026/02/07",
    "author": "Chao-Jen Huang (ephoton)",
    "title": "PSF Result Evaluation",
    "description": "Configuration for evaluating PSF simulation results with analysis-based expressions",
    "type": "object",
    "properties": {
        "$schema": {
            "description": "The schema of the evaluation configuration.",
            "type": "string",
            "format": "uri-reference"
        },
        "version": {
            "description": "Configuration file format version",
            "type": "number",
            "default": 1.0,
            "const": 1.0
        },
        "release": {
            "description": "The release date of the configuration file. Date format is \"yyyy/mm/dd\".",
            "type": "string",
            "pattern": "^(?:19|2[01])[0-9]{2}/(?:0[1-9]|1[0-2])/(?:0[1-9]|[12][0-9]|3[01])$"
        },
        "author": {
            "description": "The author of the configuration file.",
            "type": "string"
        },
        "debugMode": {
            "description": "Enable debug mode for detailed output",
            "type": "boolean",
            "default": false
        },
        "evaluation": {
            "description": "Evaluation configuration with expressions",
            "type": "object",
            "properties": {
                "enable": {
                    "description": "Enable evaluation (default: true)",
                    "type": "boolean",
                    "default": true
                },
                "variables": {
                    "description": "Variable definitions for Jinja2-style template substitution ({{variableName}})",
                    "type": "object",
                    "patternProperties": {
                        "^[a-zA-Z_][a-zA-Z0-9_]*$": {
                            "description": "Variable value (string, number, or symbol)",
                            "oneOf": [
                                {
                                    "type": "string",
                                    "minLength": 1
                                },
                                {
                                    "type": "number"
                                },
                                {
                                    "type": "boolean"
                                }
                            ]
                        }
                    },
                    "additionalProperties": false
                },
                "expressions": {
                    "description": "Expressions to evaluate against PSF results - supports both object (unordered) and array (ordered) formats",
                    "oneOf": [
                        {
                            "type": "object",
                            "description": "Expression object format (unordered execution, backward compatible)",
                            "patternProperties": {
                                "^[a-zA-Z][a-zA-Z0-9_]*$": {
                                    "description": "Expression definition (string, table with expression, or table with file)",
                                    "oneOf": [
                                        {
                                            "description": "Format 1: String expression (backward compatible)",
                                            "type": "string",
                                            "minLength": 1
                                        },
                                        {
                                            "description": "Format 2: Table with expression field",
                                            "type": "object",
                                            "properties": {
                                                "enable": {
                                                    "description": "Enable evaluation for this expression (default: true)",
                                                    "type": "boolean",
                                                    "default": true
                                                },
                                                "expression": {
                                                    "description": "Expression string (e.g., VT, VDC, IS functions)",
                                                    "type": "string",
                                                    "minLength": 1
                                                }
                                            },
                                            "required": ["expression"],
                                            "additionalProperties": false
                                        },
                                        {
                                            "description": "Format 3: Table with external file",
                                            "type": "object",
                                            "properties": {
                                                "enable": {
                                                    "description": "Enable evaluation for this expression (default: true)",
                                                    "type": "boolean",
                                                    "default": true
                                                },
                                                "file": {
                                                    "description": "Path to external SKILL file containing the expression",
                                                    "type": "string",
                                                    "minLength": 1
                                                }
                                            },
                                            "required": ["file"],
                                            "additionalProperties": false
                                        }
                                    ]
                                }
                            },
                            "additionalProperties": false,
                            "minProperties": 1
                        },
                        {
                            "type": "array",
                            "description": "Expression array format (ordered execution - recommended when expressions depend on each other)",
                            "items": {
                                "type": "object",
                                "description": "Expression item (single-key object)",
                                "patternProperties": {
                                    "^[a-zA-Z][a-zA-Z0-9_]*$": {
                                        "description": "Expression definition (string, table with expression, or table with file)",
                                        "oneOf": [
                                            {
                                                "description": "Format 1: String expression",
                                                "type": "string",
                                                "minLength": 1
                                            },
                                            {
                                                "description": "Format 2: Table with expression field",
                                                "type": "object",
                                                "properties": {
                                                    "enable": {
                                                        "description": "Enable evaluation for this expression (default: true)",
                                                        "type": "boolean",
                                                        "default": true
                                                    },
                                                    "expression": {
                                                        "description": "Expression string (e.g., VT, VDC, IS functions)",
                                                        "type": "string",
                                                        "minLength": 1
                                                    }
                                                },
                                                "required": ["expression"],
                                                "additionalProperties": false
                                            },
                                            {
                                                "description": "Format 3: Table with external file",
                                                "type": "object",
                                                "properties": {
                                                    "enable": {
                                                        "description": "Enable evaluation for this expression (default: true)",
                                                        "type": "boolean",
                                                        "default": true
                                                    },
                                                    "file": {
                                                        "description": "Path to external SKILL file containing the expression",
                                                        "type": "string",
                                                        "minLength": 1
                                                    }
                                                },
                                                "required": ["file"],
                                                "additionalProperties": false
                                            }
                                        ]
                                    }
                                },
                                "additionalProperties": false,
                                "minProperties": 1,
                                "maxProperties": 1
                            },
                            "minItems": 1
                        }
                    ]
                }
            },
            "required": ["expressions"],
            "additionalProperties": false
        }
    },
    "required": ["evaluation"],
    "additionalProperties": false
}
