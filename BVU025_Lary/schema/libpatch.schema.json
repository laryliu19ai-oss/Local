{
    "$schema": "https://json-schema.org/draft-07/schema",
    "$id": "https://example.com/libpatch.schema",
    "version": 1.0,
    "release": "2025/05/21",
    "author": "Chao-Jen Huang (ephoton)",
    "title": "Library Patching Procedure",
    "description": "Define the procedure for applying library patches",
    "type": "object",
    "properties": {
        "$schema": {
            "description": "The schema of the library patching configuration.",
            "type": "string",
            "format": "uri-reference"
        },
        "version": {
            "description": "Define the configuration file format",
            "type": "number",
            "default": 1.0,
            "const": 1.0
        },
        "release": {
            "description": "The release date of the configuration. Date format is \"yyyy/mm/dd\".",
            "type": "string",
            "pattern": "^(?:19|2[01])[0-9]{2}/(?:0[1-9]|1[0-2])/(?:0[1-9]|[12][0-9]|3[01])$"
        },
        "author": {
            "description": "The author of the configuration.",
            "type": "string"
        },
        "debugMode": {
            "description": "Enable debug mode. The default value is false.",
            "type": "boolean",
            "default": false
        },
        "libpatch": {
            "type": "object",
            "properties": {
                "overwrite": {
                    "description": "Set the default overwrite rule. If not set, overwrite will not be performed.",
                    "type": "boolean",
                    "default": false
                },
                "searchDirectory": {
                    "description": "The directory to search for symbol template configurations.",
                    "type": [ "string", "array" ],
                    "items": {
                        "type": "string"
                    },
                    "minItems": 1
                },
                "library": {
                    "type": "object",
                    "properties": {
                        "source": {
                            "type": "string"
                        },
                        "target": {
                            "type": "string"
                        },
                        "techfile": {
                            "type": "string"
                        },
                        "copiedViewTypes": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "minItems": 1
                        },
                        "copiedViewNames": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "minItems": 1
                        },
                        "removeViews": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "minItems": 1
                        }
                    },
                    "additionalProperties": false,
                    "required": [
                        "source",
                        "target"
                    ]
                },
                "cellmap": {
                    "type": "array",
                    "items": {
                        "type": [ "array", "object", "string" ],
                        "items": {
                            "type": "string"
                        },
                        "minItems": 2,
                        "maxItems": 2,
                        "properties": {
                            "cell": {
                                "type": [ "object", "array" ],
                                "$ref": "#/definitions/cellMap",
                                "items": {
                                    "type": "object",
                                    "$ref": "#/definitions/cellMap"
                                }
                            },
                            "symbol": {
                                "type": "object",
                                "properties": {
                                    "enable": {
                                        "type": "boolean",
                                        "default": false
                                    },
                                    "overwrite": {
                                        "type": "boolean",
                                        "default": false
                                    },
                                    "template": {
                                        "type": "string"
                                    },
                                    "label": {
                                        "$ref": "#/definitions/namingMap"
                                    },
                                    "pinName": {
                                        "$ref": "#/definitions/namingMap"
                                    },
                                    "pinNameGroup": {
                                        "$ref": "#/definitions/namingMapGroup"
                                    },
                                    "creation": {
                                        "oneOf": [
                                            {
                                                "type": "object",
                                                "$ref": "#/definitions/creation"
                                            },
                                            {
                                                "type": [ "array" ],
                                                "items": {
                                                    "type": "object",
                                                    "$ref": "#/definitions/creation"
                                                }
                                            }
                                        ]
                                    }
                                },
                                "additionalProperties": false
                            },
                            "schematic": {
                                "type": "object",
                                "properties": {
                                    "checkAndSave": {
                                        "description": "Check and save the schematic after patching.",
                                        "type": "boolean",
                                        "default": true
                                    }
                                },
                                "additionalProperties": false
                            },
                            "instNamePrefix": {
                                "type": "string"
                            },
                            "enable": {
                                "type": "boolean",
                                "default": false
                            },
                            "overwrite": {
                                "type": "boolean",
                                "default": false
                            }
                        },
                        "additionalProperties": false,
                        "required": [
                            "cell"
                        ]
                    }
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false,
    "definitions": {
        "creation": {
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [ "group" ]
                },
                "groups": {
                    "type": [ "array" ],
                    "items": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": false,
            "required": [
                "type",
                "groups"
            ]
        },
        "cellMap": {
            "properties": {
                "enable": {
                    "type": "boolean",
                    "default": false
                },
                "overwrite": {
                    "type": "boolean",
                    "default": false
                },
                "source": {
                    "type": "string"
                },
                "target": {
                    "type": "string"
                },
                "symbol": {
                    "type": "object",
                    "properties": {
                        "label": {
                            "$ref": "#/definitions/namingMap"
                        },
                        "pinName": {
                            "$ref": "#/definitions/namingMap"
                        },
                        "pinNameGroup": {
                            "$ref": "#/definitions/namingMapGroup"
                        }
                    },
                    "additionalProperties": false
                },
                "schematic": {
                    "type": "object",
                    "properties": {
                        "checkAndSave": {
                            "description": "Check and save the schematic after patching.",
                            "type": "boolean",
                            "default": true
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false,
            "required": [
                "source",
                "target"
            ]
        },
        "namingMap": {
            "type": "object",
            "patternProperties": {
                "^[a-zA-Z0-9_]+$": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "namingMapGroup": {
            "type": "object",
            "patternProperties": {
                "^[a-zA-Z0-9_]+$": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": false
        }
    }
}