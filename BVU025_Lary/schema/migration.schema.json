{
    "$schema": "https://json-schema.org/draft-07/schema",
    "$id": "https://example.com/migration.schema",
    "version": 1.0,
    "release": "2025/05/08",
    "author": "Chao-Jen Huang (ephoton)",
    "title": "Design Migration",
    "type": "object",
    "properties": {
        "$schema": {
            "description": "The schema of the design migration configuration.",
            "type": "string",
            "format": "uri-reference"
        },
        "version": {
            "description": "Define the design migration configuration format",
            "type": "number",
            "default": 1.0,
            "const": 1.0
        },
        "release": {
            "description": "The release date of the configuration. Date format is \"yyyy/mm/dd\".",
            "type": "string",
            "pattern": "^(?:19|2[01])[0-9]{2}/(?:0[1-9]|1[0-2])/(?:0[1-9]|[12][0-9]|3[01])$"
        },
        "author": {
            "description": "The author of the configuration.",
            "type": "string"
        },
        "debugMode": {
            "description": "Enable the debug mode to dump overall details.",
            "type": "boolean",
            "default": false
        },
        "migration": {
            "type": "object",
            "properties": {
                "cellLibrary": {
                    "type": "object",
                    "patternProperties": {
                        "^[a-zA-Z0-9_]+$": {
                            "type": "object",
                            "properties": {
                                "height": {
                                    "type": [ "number", "integer" ]
                                },
                                "pitch": {
                                    "type": [ "number", "integer" ]
                                },
                                "boundary": {
                                    "type": [ "object", "string" ],
                                    "properties": {
                                        "layer": {
                                            "type": "string"
                                        },
                                        "purpose": {
                                            "type": "string"
                                        }
                                    },
                                    "default": "prBoundary",
                                    "additionalProperties": false
                                },
                                "cell": {
                                    "type": "object",
                                    "patternProperties": {
                                        "^[a-zA-Z0-9_]+$": {
                                            "type": "object",
                                            "properties": {
                                                "width": {
                                                    "type": [ "number", "integer" ]
                                                },
                                                "port": {
                                                    "type": "object",
                                                    "patternProperties": {
                                                        "^[a-zA-Z0-9_]+$": {
                                                            "type": "array",
                                                            "items": {
                                                                "type": [ "number", "integer" ]
                                                            },
                                                            "minItems": 2,
                                                            "maxItems": 2
                                                        }
                                                    }
                                                }
                                            },
                                            "additionalProperties": false
                                        }
                                    }
                                }
                            },
                            "additionalProperties": false
                        }
                    }
                },
                "log": {
                    "type": "object",
                    "properties": {
                        "enable": {
                            "description": "Enable the log file or not.",
                            "type": "boolean",
                            "default": true
                        },
                        "dumpDetails": {
                            "description": "Dump the design structure or not.",
                            "type": "boolean",
                            "default": true
                        },
                        "filename": {
                            "description": "The log file name.",
                            "type": "string"
                        }
                    },
                    "additionalProperties": false
                },
                "rule": {
                    "type:": [ "object", "string" ],
                    "patternProperties": {
                        "^[a-zA-Z0-9_]+$": {
                                "$ref": "#/definitions/processDefinition"
                        },
                        "^[a-zA-Z0-9_]+/[a-zA-Z0-9_]+$": {
                            "$ref": "#/definitions/processMigrationMap"
                        }
                    },
                    "additionalProperties": false
                },
                "library": {
                    "$ref": "#/definitions/sourceTarget"
                },
                "cell": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "layout": {
                    "type": "object",
                    "properties": {
                        "designReference": {
                            "type": "object",
                            "properties": {
                                "enable": {
                                    "description": "Enable the design reference migration or not.",
                                    "type": "boolean"
                                },
                                "onlyMappingList": {
                                    "description": "Only migrate the mapping list or not.",
                                    "type": "boolean"
                                },
                                "mappingList": {
                                    "type": "object",
                                    "additionalProperties": {
                                        "type": "string"
                                    }
                                }
                            },
                            "additionalProperties": false
                        },
                        "ignoreInstance": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                "cell": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                "library": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            },
                            "additionalProperties": false
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false,
    "definitions": {
        "coordinateWithCdfParameter": {
            "type": "array",
            "items": {
                "type": [ "number", "integer", "string" ]
            },
            "minItems": 2,
            "maxItems": 2
        },
        "coordinate": {
            "type": "array",
            "items": {
                "type": [ "number", "integer" ]
            },
            "minItems": 2,
            "maxItems": 2
        },
        "points": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/coordinate"
            }
        },
        "justification": {
            "type": "string",
            "enum": [
                "lowerLeft",
                "lowerCenter",
                "lowerRight",
                "centerLeft",
                "centerCenter",
                "centerRight",
                "upperLeft",
                "upperCenter",
                "upperRight"
            ],
            "default": "centerCenter"
        },
        "orientation": {
            "type": "string",
            "enum": [
                "R0",
                "R90",
                "R180",
                "R270",
                "MY",
                "MYR90",
                "MX",
                "MXR90"
            ],
            "default": "R0"
        },
        "nameTechFile": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "techFile": {
                    "type": "string"
                },
                "options": {
                    "type": "object",
                    "patternProperties": {
                        "^[a-zA-Z0-9_]+$": {
                            "type": "string"
                        }
                    }
                }
            },
            "additionalProperties": false
        },
        "sourceTarget": {
            "type": "object",
            "properties": {
                "source": {
                    "$ref": "#/definitions/nameTechFile"
                },
                "target": {
                    "$ref": "#/definitions/nameTechFile"
                },
                "transfer": {
                    "type": "object",
                    "patternProperties": {
                        "^[a-zA-Z0-9_]+$": {
                            "type": "string",
                            "pattern": "^[a-zA-Z0-9_]+$"
                        }
                    }
                },
                "hierarchy": {
                    "description": "Migrate the cellview with hierarchy or not.",
                    "type": "boolean",
                    "default": true
                },
                "ignore": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "library": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "minItems": 1
                            },
                            "cell": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "minItems": 1
                            }
                        },
                        "additionalProperties": false,
                        "oneOf": [
                            {
                                "required": [
                                    "library"
                                ]
                            },
                            {
                                "required": [
                                    "cell"
                                ]
                            }
                        ]
                    },
                    "minItems": 1
                }
            },
            "additionalProperties": false
        },
        "migrationCdf": {
            "type": "object",
            "patternProperties": {
                "^.*$": {
                    "type": "object",
                    "properties": {
                        "preparation": {
                            "$ref": "#/definitions/migrationParameters"
                        },
                        "execution": {
                            "$ref": "#/definitions/migrationParameters"
                        },
                        "completion": {
                            "$ref": "#/definitions/migrationParameters"
                        },
                        "inheritanceRules": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        },
        "migrationParameters": {
            "type": "object",
            "patternProperties": {
                "^.*$": {
                    "$ref": "#/definitions/migrationParameter"
                }
            },
            "additionalProperties": false
        },
        "migrationParameter": {
            "type": "object",
            "properties": {
                "description": {
                    "description": "The description of the parameter.",
                    "type": "string"
                },
                "method": {
                    "description": "The method to calculate the parameter.",
                    "type": "string",
                    "enum": [ "manual", "source" ],
                    "default": "source"
                },
                "type": {
                    "description": "The type of the parameter.",
                    "type": "string",
                    "enum": [ "string", "integer", "boolean" ],
                    "default": "string"
                },
                "evalstring": {
                    "description": "Evaluate the string or not.",
                    "type": "boolean",
                    "default": false
                },
                "value": {
                    "description": "The value of the parameter.",
                    "type": [ "string", "integer", "number", "boolean" ]
                }
            },
            "additionalProperties": false
        },
        "processDefinition": {
            "type": "object",
            "properties": {
                "definition": {
                    "type": "object",
                    "patternProperties": {
                        "^[a-zA-Z0-9_]+(?:/[a-zA-Z0-9_]+)?$": {
                            "type": "string"
                        }
                    },
                    "additionalProperties": false,
                    "required": [ 
                        "pactive",
                        "nactive",
                        "poly1",
                        "diffusion",
                        "contact",
                        "metal1",
                        "via12",
                        "metal2"
                    ]
                },
                "via": {
                    "type": "object",
                    "patternProperties": {
                        "^[a-zA-Z0-9_]+(?:/[a-zA-Z0-9_]+)?$": {
                            "type": [ "string", "array" ],
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    "additionalProperties": false
                },
                "designRule": {
                    "type": "object",
                    "patternProperties": {
                        "^[a-zA-Z0-9_]+(?:/[a-zA-Z0-9_]+)?$": {
                            "type": "object",
                            "patternProperties": {
                                "^(?:#|[a-zA-Z0-9_]+(?:/[a-zA-Z0-9_]+)?)$": {
                                    "type": "object",
                                    "patternProperties": {
                                        "^[a-zA-Z0-9_]+$": {
                                            "type": [ "number", "integer" ]
                                        }
                                    },
                                    "additionalProperties": false
                                }
                            },
                            "additionalProperties": false
                        }
                    }
                },
                "layer": {
                    "type": "object",
                    "patternProperties": {
                        "^[a-zA-Z0-9_]+(?:/[a-zA-Z0-9_]+)?$": {
                            "type": "string",
                            "pattern": "^[a-zA-Z0-9_]+(?:/[a-zA-Z0-9_]+)?$"
                        }
                    },
                    "additionalProperties": false
                },
                "instance": {
                    "type": "object",
                    "patternProperties": {
                        "^[a-zA-Z0-9_]+$": {
                            "type": "object",
                            "properties": {
                                "offset": {
                                    "$ref": "#/definitions/coordinateWithCdfParameter"
                                },
                                "orientation": {
                                    "$ref": "#/definitions/orientation"
                                }
                            },
                            "additionalProperties": false
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        },
        "processMigrationMap": {
            "type": "object",
            "properties": {
                "cdf": {
                    "$ref": "#/definitions/migrationCdf"
                },
                "rod": {
                    "type": "object",
                    "patternProperties": {
                        "^[a-zA-Z0-9_]+$": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "enum": [
                                        "masterPath",
                                        "offsetPath",
                                        "enclosurePath",
                                        "rectangle"
                                    ],
                                    "default": "masterPath"
                                },
                                "beginOffset": {
                                    "type": [ "number", "integer" ]
                                },
                                "endOffset": {
                                    "type": [ "number", "integer" ]
                                },
                                "beginSegmentOffset": {
                                    "type": [ "number", "integer" ]
                                },
                                "endSegmentOffset": {
                                    "type": [ "number", "integer" ]
                                },
                                "enclosure": {
                                    "type": [ "number", "integer" ]
                                },
                                "width": {
                                    "type": [ "number", "integer" ]
                                },
                                "length": {
                                    "type": [ "number", "integer" ]
                                },
                                "space": {
                                    "type": [ "number", "integer" ]
                                },
                                "separation": {
                                    "type": [ "number", "integer" ]
                                },
                                "gap": {
                                    "type": "string",
                                    "enum": [
                                        "distribute",
                                        "minimum"
                                    ],
                                    "default": "distribute"
                                },
                                "justification": {
                                    "type": "string",
                                    "enum": [
                                        "left",
                                        "center",
                                        "right"
                                    ],
                                    "default": "center"
                                },
                                "choppable": {
                                    "type": "boolean",
                                    "default": true
                                },
                                "diagonal": {
                                    "type": "boolean",
                                    "default": false
                                }
                            },
                            "additionalProperties": false,
                            "if": {
                                "properties": {
                                    "type": {
                                        "const": "masterPath"
                                    }
                                }
                            },
                            "then": {
                                "required": [
                                    "justification",
                                    "width"
                                ]
                            },
                            "else": {
                                "if": {
                                    "properties": {
                                        "type": {
                                            "const": "offsetPath"
                                        }
                                    }
                                },
                                "then": {
                                    "required": [
                                        "justification",
                                        "width"
                                    ]
                                },
                                "else": {
                                    "if": {
                                        "properties": {
                                            "type": {
                                                "const": "enclosurePath"
                                            }
                                        }
                                    },
                                    "then": {
                                        "required": [
                                            "enclosure"
                                        ]
                                    },
                                    "else": {
                                        "required": [
                                            "width",
                                            "length",
                                            "space"
                                        ]
                                    }
                                }
                            }
                        }
                    },
                    "additionalProperties": false
                },
                "instance": {
                    "type": "object",
                    "patternProperties": {
                        "^[a-zA-Z0-9_]+$": {
                            "type": "object",
                            "patternProperties": {
                                "^[a-zA-Z0-9_]+$": {
                                    "type": [ "string", "object" ],
                                    "pattern": "^[a-zA-Z0-9_]+$",
                                    "properties": {
                                        "metalScheme": {
                                            "type": "object",
                                            "patternProperties": {
                                                "^[a-zA-Z0-9_]+$": {
                                                    "type": "string"
                                                }
                                            }
                                        },
                                        "highResOption": {
                                            "type": "object",
                                            "patternProperties": {
                                                "^[a-zA-Z0-9_]+$": {
                                                    "type": "string"
                                                }
                                            }
                                        },
                                        "mimCapOption": {
                                            "type": "object",
                                            "patternProperties": {
                                                "^[a-zA-Z0-9_]+$": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    },
                                    "additionalProperties": false
                                }
                            },
                            "additionalProperties": false
                        }
                    }
                },
                "check": {
                    "type": "object",
                    "patternProperties": {
                        "^[a-zA-Z0-9_]+$": {
                            "type": "object",
                            "properties": {
                                "compare": {
                                    "type": "string",
                                    "enum": [ "exactly", "difference", "range" ],
                                    "default": "exactly"
                                },
                                "difference": {
                                    "type": "string",
                                    "enum": [ "percentage", "relative", "absolute" ],
                                    "default": "percentage"
                                },
                                "range": {
                                    "type": "array",
                                    "items": {
                                        "type": "number"
                                    },
                                    "minItems": 2,
                                    "maxItems": 2
                                }
                            },
                            "additionalProperties": false
                        }
                    }
                }
            },
            "additionalProperties": false
        }
    }
}