{
    "$schema": "https://json-schema.org/draft-07/schema",
    "$id": "https://example.com/padinfo.schema",
    "version": 1.0,
    "release": "2025/12/21",
    "author": "Chao-Jen Huang (ephoton)",
    "title": "CDL Pad Information",
    "description": "Define the pad information of CDL netlist",
    "type": "object",
    "properties": {
        "$schema": {
            "description": "The schema of the PDK option configuration.",
            "type": "string",
            "format": "uri-reference"
        },
        "version": {
            "description": "Define the configuration file format",
            "type": "number",
            "default": 1.0,
            "const": 1.0
        },
        "release": {
            "description": "The release date of the configuration. Date format is \"yyyy/mm/dd\".",
            "type": "string",
            "pattern": "^(?:19|2[01])[0-9]{2}/(?:0[1-9]|1[0-2])/(?:0[1-9]|[12][0-9]|3[01])$"
        },
        "author": {
            "description": "The author of the configuration.",
            "type": "string"
        },
        "padinfo": {
            "description": "The pad information for different cell types.",
            "type": "object",
            "properties": {
                "*": {
                    "description": "The common pad definitions for all cell types.",
                    "type": "object",
                    "properties": {
                        "input": {
                            "description": "List of input pads.",
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "minItems": 1
                        },
                        "output": {
                            "description": "List of output pads.",
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "minItems": 1
                        },
                        "bidirectional": {
                            "description": "List of bidirectional pads.",
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "minItems": 1
                        }
                    },
                    "additionalProperties": false
                }
            },
            "patternProperties": {
                "^[a-zA-Z0-9_]+$": {
                    "description": "Pad definitions for specific cell types.",
                    "type": "object",
                    "properties": {
                        "input": {
                            "description": "List of input pads for the specific cell type.",
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "minItems": 1
                        },
                        "output": {
                            "description": "List of output pads for the specific cell type.",
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "minItems": 1
                        },
                        "bidirectional": {
                            "description": "List of bidirectional pads for the specific cell type.",
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "minItems": 1
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}