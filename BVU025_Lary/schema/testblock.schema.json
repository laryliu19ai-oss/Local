{
    "$schema": "https://json-schema.org/draft-07/schema",
    "$id": "https://example.com/testblock.schema",
    "version": 1.0,
    "release": "2026/01/12",
    "author": "Chao-Jen Huang (ephoton)",
    "title": "Test Block Generator",
    "description": "Define the test block for testbenches",
    "type": "object",
    "properties": {
        "$schema": {
            "description": "The schema of the circuit simulation configuration.",
            "type": "string",
            "format": "uri-reference"
        },
        "version": {
            "description": "Define the circuit simulation file format",
            "type": "number",
            "default": 1.0,
            "const": 1.0
        },
        "release": {
            "description": "The release date of the circuit simulation. Date format is \"yyyy/mm/dd\".",
            "type": "string",
            "pattern": "^(?:19|2[01])[0-9]{2}/(?:0[1-9]|1[0-2])/(?:0[1-9]|[12][0-9]|3[01])$"
        },
        "author": {
            "description": "The author of the circuit simulation.",
            "type": "string"
        },
        "debugMode": {
            "type": "boolean",
            "default": false
        },
        "testBlock": {
            "type": "object",
            "properties": {
                "library": {
                    "type": "string",
                    "description": "The library name of the test block."
                },
                "cell": {
                    "type": "string",
                    "description": "The cell name of the test block."
                },
                "supply": {
                    "type": "string"
                },
                "ground": {
                    "type": "string"
                },
                "input": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "output": {
                    "type": "array",
                    "items": {
                        "type": [ "object", "string" ],
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "length": {
                                "type": "integer",
                                "minimum": 1,
                                "description": "Bit width of the output signal (1 for single-bit, >1 for bus)"
                            },
                            "default": {
                                "type": [ "string", "integer", "number" ]
                            }
                        },
                        "additionalProperties": false,
                        "required": [ "name" ]
                    }
                }
            },
            "additionalProperties": false,
            "required": [
                "library",
                "cell",
                "supply",
                "ground",
                "output"
            ]
        }
    }
}