{
    "$schema": "https://json-schema.org/draft-07/schema",
    "$id": "https://example.com/va_autogen.schema",
    "version": 1.0,
    "release": "2024/05/17",
    "author": "Chao-Jen Huang (ephoton)",
    "title": "VerilogA Auto Generation",
    "description": "The schema validates the minimum requirements for VerilogA auto Generation",
    "type": "object",
    "properties": {
        "$schema": {
            "type": "string"
        },
        "version": {
            "description": "Define the cellview file format",
            "type": "number",
            "default": 1.0,
            "const": 1.0
        },
        "release": {
            "description": "The release date of the cellview. Date format is \"yyyy/mm/dd\".",
            "type": "string",
            "pattern": "^(?:19|2[01])[0-9]{2}/(?:0[1-9]|1[0-2])/(?:0[1-9]|[12][0-9]|3[01])$"
        },
        "author": {
            "description": "The author of the cellview.",
            "type": "string"
        },
        "database": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "file": {
                        "description": "Specify the file path of autogen",
                        "type": "string"
                    },
                    "naming_rule": {
                        "description": "Specify the generated file rules, all # symbols will be replaced.",
                        "type": "string",
                        "pattern": "#"
                    },
                    "range": {
                        "type": "array",
                        "items": {
                            "description": "Specify the number range to be generated.",
                            "type": [ "integer", "array" ],
                            "items": {
                                "type": "integer"
                            },
                            "minItems": 2,
                            "maxItems": 3
                        },
                        "minItems": 1
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}