{
    "$schema": "https://json-schema.org/draft-07/schema",
    "$id": "https://example.com/vacontrol.schema",
    "version": 1.0,
    "release": "2025/01/21",
    "author": "Chao-Jen Huang (ephoton)",
    "title": "VerilogA Control Testbench Creation",
    "description": "The schema validates the minimum requirements for cell view",
    "type": "object",
    "properties": {
        "$schema": {
            "description": "The schema of the cellview replacement configuration.",
            "type": "string",
            "format": "uri-reference"
        },
        "version": {
            "description": "Define the cellview file format",
            "type": "number",
            "default": 1.0,
            "const": 1.0
        },
        "release": {
            "description": "The release date of the cellview. Date format is \"yyyy/mm/dd\".",
            "type": "string",
            "pattern": "^(?:19|2[01])[0-9]{2}/(?:0[1-9]|1[0-2])/(?:0[1-9]|[12][0-9]|3[01])$"
        },
        "author": {
            "description": "The author of the cellview.",
            "type": "string"
        },
        "library": {
            "description": "Define imported library name. This field will be overridden by the category's library name setting.",
            "type": "string",
            "pattern": "^[A-Za-z0-9_$#]*$"
        },
        "cell": {
            "description": "Define imported cell name.",
            "type": "string",
            "pattern": "^[A-Za-z0-9_$#]*$"
        },
        "configuration": {
            "type": "object",
            "properties": {
                "power": {
                    "type": "string"
                },
                "ground": {
                    "type": "string"
                },
                "input": {
                    "$ref": "#/definitions/port"
                },
                "output": {
                    "$ref": "#/definitions/port"
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false,
    "definitions": {
        "port": {
            "type": "object",
            "patternProperties": {
                "\\w+": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "enum": [ "analog", "digital" ],
                            "default": "digital"
                        },
                        "length": {
                            "type": "integer",
                            "default": 1,
                            "minimum": 1
                        },
                        "parameter": {
                            "type": "string"
                        },
                        "variable": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "type",
                        "parameter",
                        "variable"
                    ],
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        }
    }
}