let((cv)
    cv = hdbOpen("BVU025_Lary" "sim_TOP_cosim_A1" "config" "a")
    when(cv
        hdbSetCellBinding(cv "BVU025_Lary" "Bias_A1" "analogtext")
        hdbSetCellBinding(cv "BVU025_Lary" "AN2x1" "analogtext")
        hdbSetCellBinding(cv "BVU025_Lary" "Buffer_DIG" "functional")
        hdbSetCellBinding(cv "BVU025_Lary" "vaSAR6b" "veriloga")
        hdbSetCellBinding(cv "BVU025_Lary" "vaVDAC6b_FIXED" "veriloga")
        hdbRecompute(cv)
        hdbSave(cv)
        hdbClose(cv)
        printf("HDB Config for sim_TOP_cosim_A1 recomputed and saved successfully!\n")
    )
)
exit()
