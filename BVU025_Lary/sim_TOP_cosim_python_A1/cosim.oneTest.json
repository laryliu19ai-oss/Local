{
    "$schema": "schema/oneTest.schema.json",
    "version": 1.0,
    "release": "2026/08/20",
    "author": "Lary Liu",
    "debugMode": true,
    "oneTest": {
        "ic_code": "BVU025",
        "revision": "A",
        "combo_version": "A0",
        "combo_meta": {
            "purpose": "engineering",
            "backend_change": "SAR IRef calibration co-simulation with Python controlling TOP_A1"
        },
        "spec_version": "1.4.0",
        "packages": {
            "WLCSP-6x6-P0.40mm-D0.25mm": {
                "note": "WLCSP 36-ball package for BVU025_A1",
                "solder_ball": {
                    "unit": "um",
                    "body_width": 2400,
                    "body_length": 2400,
                    "body_height": 250,
                    "ball_count_x": 6,
                    "ball_count_y": 6,
                    "x_pitch": 400,
                    "y_pitch": 400,
                    "diameter": 250,
                    "ball_height": 180
                },
                "footprint": {
                    "lib": "Package_CSP",
                    "fp_type": "wlcsp",
                    "pad_shape": "circle"
                }
            },
            "SMD_0402": {
                "standard": {
                    "spec": "IEC 60063 / EIA-198",
                    "code": "0402",
                    "metric_code": "1005"
                },
                "footprint": {
                    "fp_type": "smd",
                    "kicad_dist_ref": "Resistor_SMD.pretty/R_0402_1005Metric.kicad_mod"
                }
            },
            "SMD_0805": {
                "standard": {
                    "spec": "IEC 60063 / EIA-198",
                    "code": "0805",
                    "metric_code": "2012"
                },
                "footprint": {
                    "fp_type": "smd",
                    "kicad_dist_ref": "Capacitor_SMD.pretty/C_0805_2012Metric.kicad_mod"
                }
            }
        },
        "components": {
            "TOP_A1": {
                "package": "WLCSP-6x6-P0.40mm-D0.25mm",
                "size": {
                    "unit": "um",
                    "x": 2400,
                    "y": 2400
                },
                "design": {
                    "library": "BVU025_Lary",
                    "cell": "TOP_A1"
                },
                "spice_type": "sub-circuit",
                "pins": {
                    "aVdd": {
                        "position": "D6",
                        "type": "analog power",
                        "function": "Analog Main Power Supply 3.3V."
                    },
                    "aVss": {
                        "position": "C4",
                        "type": "analog ground",
                        "function": "Analog Ground 0V."
                    },
                    "TMIRefOn": {
                        "position": "C1",
                        "type": "digital input",
                        "function": "Test Mode IRef Trim Enable Control."
                    },
                    "TMIRefMeas": {
                        "position": "C2",
                        "type": "digital input",
                        "function": "Test Mode IRef Output Measurement Enable Control."
                    },
                    "GPIO8": {
                        "position": "E2",
                        "type": "digital input/output",
                        "function": "External Calibration & Measurement Pin (receives 2uA ISARC or outputs trimmed IRef)."
                    },
                    "NvTrmIref": {
                        "position": [
                            "E3",
                            "E5",
                            "D1",
                            "D4",
                            "C5",
                            "E1"
                        ],
                        "type": "digital input",
                        "function": "6-bit SAR Trim Code Input Bus (NvTrmIref<5:0>)."
                    },
                    "dIRefTMO": {
                        "position": "D2",
                        "type": "digital input/output",
                        "function": "Internal Comparator Digital Output to SAR Logic."
                    }
                }
            },
            "CAP_0805": {
                "package": "SMD_0805",
                "design": {
                    "library": "analogLib",
                    "cell": "cap"
                },
                "spice_type": "capacitor",
                "default_value": "10u",
                "pins": {
                    "PLUS": {
                        "position": 0,
                        "type": "none",
                        "function": "Node 1"
                    },
                    "MINUS": {
                        "position": 1,
                        "type": "none",
                        "function": "Node 2"
                    }
                }
            },
            "RES_0402": {
                "package": "SMD_0402",
                "design": {
                    "library": "analogLib",
                    "cell": "res"
                },
                "spice_type": "resistor",
                "default_value": "2.2k",
                "pins": {
                    "PLUS": {
                        "position": 0,
                        "type": "none",
                        "function": "Node 1"
                    },
                    "MINUS": {
                        "position": 1,
                        "type": "none",
                        "function": "Node 2"
                    }
                }
            }
        },
        "testers": {
            "sim": {
                "TESTER": {
                    "design": {
                        "library": "tester",
                        "cell": "virtual_tester"
                    },
                    "spice_type": "sub-circuit",
                    "pins": {
                        "aVdd": {
                            "type": "power",
                            "function": "Primary supply voltage source to DUT.",
                            "capabilities": [
                                "voltage_source"
                            ]
                        },
                        "aVss": {
                            "type": "power ground",
                            "function": "Common ground reference."
                        },
                        "TMIRefOn": {
                            "type": "digital input/output",
                            "function": "Digital control drive for TMIRefOn.",
                            "capabilities": [
                                "digital_source",
                                "voltage_source"
                            ]
                        },
                        "TMIRefMeas": {
                            "type": "digital input/output",
                            "function": "Digital control drive for TMIRefMeas.",
                            "capabilities": [
                                "digital_source",
                                "voltage_source"
                            ]
                        },
                        "GPIO8": {
                            "type": "analog input",
                            "function": "Source 2uA ISAR current / Sense trimmed IRef current.",
                            "capabilities": [
                                "current_source",
                                "current_measurement",
                                "voltage_source"
                            ]
                        },
                        "NvTrmIref": {
                            "type": "digital input/output",
                            "function": "Digital bus drive for SAR Trim bits.",
                            "capabilities": [
                                "digital_source"
                            ]
                        },
                        "dIRefTMO": {
                            "type": "digital input/output",
                            "function": "Comparator output monitor/readout.",
                            "capabilities": [
                                "digital_measurement",
                                "voltage_measurement"
                            ]
                        }
                    }
                }
            },
            "lab": {
                "SMU_2450": {
                    "design": {
                        "library": "lab.instruments.smu.smu2450",
                        "cell": "SMU2450Core"
                    },
                    "spice_type": "sub-circuit",
                    "pins": {
                        "OUT": {
                            "type": "power",
                            "function": "Sourced voltage output wired to DUT aVdd.",
                            "capabilities": [
                                "voltage_source"
                            ]
                        },
                        "GND": {
                            "type": "power ground",
                            "function": "Chassis ground reference."
                        }
                    }
                },
                "STM32F439": {
                    "design": {
                        "library": "lab.stm32.st.stm32f439",
                        "cell": "STM32F439"
                    },
                    "spice_type": "sub-circuit",
                    "pins": {
                        "TMIRefOn": {
                            "type": "digital input/output",
                            "function": "Digital drive for TMIRefOn.",
                            "capabilities": [
                                "digital_source"
                            ]
                        },
                        "TMIRefMeas": {
                            "type": "digital input/output",
                            "function": "Digital drive for TMIRefMeas.",
                            "capabilities": [
                                "digital_source"
                            ]
                        },
                        "NvTrmIref": {
                            "type": "digital input/output",
                            "function": "Digital bus drive for NvTrmIref<5:0>.",
                            "capabilities": [
                                "digital_source"
                            ]
                        },
                        "dIRefTMO": {
                            "type": "digital input/output",
                            "function": "Digital sense for dIRefTMO.",
                            "capabilities": [
                                "digital_measurement"
                            ]
                        },
                        "GND": {
                            "type": "power ground",
                            "function": "Common ground reference."
                        }
                    }
                },
                "SMU_2461": {
                    "design": {
                        "library": "lab.instruments.smu.smu2461",
                        "cell": "SMU2461Core"
                    },
                    "spice_type": "sub-circuit",
                    "pins": {
                        "OUT": {
                            "type": "power",
                            "function": "Sourced current output (2uA) / sense wired to GPIO8.",
                            "capabilities": [
                                "current_source",
                                "voltage_source"
                            ]
                        },
                        "GND": {
                            "type": "power ground",
                            "function": "Source-measure low ground reference."
                        }
                    }
                },
                "DMM_6510": {
                    "design": {
                        "library": "lab.instruments.dmm.dmm6500",
                        "cell": "DMM6500Core"
                    },
                    "spice_type": "sub-circuit",
                    "pins": {
                        "SOURCE": {
                            "type": "analog input",
                            "function": "Sense input probing GPIO8 reference current.",
                            "capabilities": [
                                "current_measurement",
                                "voltage_measurement"
                            ]
                        },
                        "GND": {
                            "type": "power ground",
                            "function": "Sense low ground reference."
                        }
                    }
                },
                "MSO58": {
                    "design": {
                        "library": "lab.instruments.oscilloscope.mso456",
                        "cell": "MSO456Core"
                    },
                    "spice_type": "sub-circuit",
                    "pins": {
                        "CH1": {
                            "type": "analog input",
                            "function": "Probe channel 1 for aVdd.",
                            "capabilities": [
                                "waveform_measurement"
                            ]
                        },
                        "CH2": {
                            "type": "analog input",
                            "function": "Probe channel 2 for TMIRefOn.",
                            "capabilities": [
                                "waveform_measurement"
                            ]
                        },
                        "CH3": {
                            "type": "analog input",
                            "function": "Probe channel 3 for TMIRefMeas.",
                            "capabilities": [
                                "waveform_measurement"
                            ]
                        },
                        "CH4": {
                            "type": "analog input",
                            "function": "Probe channel 4 for GPIO8.",
                            "capabilities": [
                                "waveform_measurement"
                            ]
                        },
                        "CH5": {
                            "type": "analog input",
                            "function": "Probe channel 5 for dIRefTMO.",
                            "capabilities": [
                                "waveform_measurement"
                            ]
                        }
                    }
                }
            },
            "ate": {
                "ACCOTEST_STS8200": {
                    "design": {
                        "library": "ate.accotest",
                        "cell": "STS8200"
                    },
                    "spice_type": "sub-circuit",
                    "pins": {
                        "V0": {
                            "type": "power",
                            "function": "Dedicated aVdd force channel.",
                            "capabilities": [
                                "voltage_source"
                            ]
                        },
                        "A0": {
                            "type": "analog input",
                            "function": "FOVI channel wired to aVdd sense.",
                            "capabilities": [
                                "voltage_measurement"
                            ]
                        },
                        "A1": {
                            "type": "analog input",
                            "function": "FOVI channel measuring GPIO8 reference current.",
                            "capabilities": [
                                "current_measurement",
                                "voltage_source"
                            ]
                        },
                        "D1": {
                            "type": "digital input/output",
                            "function": "Digital channel mapped to TMIRefOn.",
                            "capabilities": [
                                "digital_source"
                            ]
                        },
                        "D2": {
                            "type": "digital input/output",
                            "function": "Digital channel mapped to TMIRefMeas.",
                            "capabilities": [
                                "digital_source"
                            ]
                        },
                        "D3": {
                            "type": "digital input/output",
                            "function": "Digital channel mapped to dIRefTMO sense.",
                            "capabilities": [
                                "digital_measurement"
                            ]
                        },
                        "GND0": {
                            "type": "power ground",
                            "function": "Tester ground channel 0."
                        },
                        "GND1": {
                            "type": "power ground",
                            "function": "Tester ground channel 1."
                        },
                        "GND2": {
                            "type": "power ground",
                            "function": "Tester ground channel 2."
                        },
                        "GND3": {
                            "type": "power ground",
                            "function": "Tester ground channel 3."
                        },
                        "GND4": {
                            "type": "power ground",
                            "function": "Tester ground channel 4."
                        },
                        "GND5": {
                            "type": "power ground",
                            "function": "Tester ground channel 5."
                        }
                    }
                },
                "MSO24": {
                    "design": {
                        "library": "lab.instruments.oscilloscope.mso2",
                        "cell": "MSO2Core"
                    },
                    "spice_type": "sub-circuit",
                    "pins": {
                        "CH1": {
                            "type": "analog input",
                            "function": "Oscilloscope channel 1 probe for aVdd.",
                            "capabilities": [
                                "waveform_measurement"
                            ]
                        },
                        "CH2": {
                            "type": "analog input",
                            "function": "Oscilloscope channel 2 probe for GPIO8.",
                            "capabilities": [
                                "waveform_measurement"
                            ]
                        },
                        "CH3": {
                            "type": "analog input",
                            "function": "Oscilloscope channel 3 probe for dIRefTMO.",
                            "capabilities": [
                                "waveform_measurement"
                            ]
                        },
                        "CH4": {
                            "type": "analog input",
                            "function": "Oscilloscope channel 4 probe for TMIRefMeas.",
                            "capabilities": [
                                "waveform_measurement"
                            ]
                        }
                    }
                }
            }
        },
        "testboard": {
            "components": {
                "DUT": {
                    "id": "TOP_A1",
                    "connection": {
                        "aVdd": "aVdd",
                        "aVss": "aVss",
                        "TMIRefOn": "TMIRefOn",
                        "TMIRefMeas": "TMIRefMeas",
                        "GPIO8": "GPIO8",
                        "NvTrmIref": "NvTrmIref",
                        "dIRefTMO": "dIRefTMO"
                    }
                },
                "CIN": {
                    "id": "CAP_0805",
                    "connection": {
                        "aVdd": "PLUS",
                        "aVss": "MINUS"
                    },
                    "value": "10u"
                }
            }
        },
        "testbench": {
            "sim": {
                "components": {
                    "TESTER": {
                        "id": "TESTER",
                        "connection": {
                            "aVdd": "aVdd",
                            "aVss": "aVss",
                            "TMIRefOn": "TMIRefOn",
                            "TMIRefMeas": "TMIRefMeas",
                            "GPIO8": "GPIO8",
                            "NvTrmIref": "NvTrmIref",
                            "dIRefTMO": "dIRefTMO"
                        },
                        "measurements": {
                            "101": {
                                "tb": "dpi_c",
                                "settle_ns": 200
                            },
                            "102": {
                                "tb": "dpi_c",
                                "wave_db_mode": "simvision",
                                "time_range": {
                                    "start": "0ns",
                                    "end": "2000000ns"
                                }
                            },
                            "103": {
                                "tb": "dpi_c",
                                "settle_ns": 500
                            }
                        }
                    },
                    "VGND": {
                        "id": "global_ground",
                        "connection": {
                            "aVss": 0
                        }
                    }
                }
            },
            "lab": {
                "components": {
                    "PSU": {
                        "id": "SMU_2450",
                        "connection": {
                            "aVdd": "OUT",
                            "aVss": "GND"
                        }
                    },
                    "MCU": {
                        "id": "STM32F439",
                        "connection": {
                            "TMIRefOn": "TMIRefOn",
                            "TMIRefMeas": "TMIRefMeas",
                            "NvTrmIref": "NvTrmIref",
                            "dIRefTMO": "dIRefTMO",
                            "aVss": "GND"
                        }
                    },
                    "SMU1": {
                        "id": "SMU_2461",
                        "connection": {
                            "GPIO8": "OUT",
                            "aVss": "GND"
                        }
                    },
                    "DMM1": {
                        "id": "DMM_6510",
                        "connection": {
                            "GPIO8": "SOURCE",
                            "aVss": "GND"
                        },
                        "measurements": {
                            "103": {
                                "function": "CURR:DC",
                                "autorange": true,
                                "nplc": 10,
                                "read_mode": "READ"
                            }
                        }
                    },
                    "SCOPE0": {
                        "id": "MSO58",
                        "connection": {
                            "aVdd": "CH1",
                            "TMIRefOn": "CH2",
                            "TMIRefMeas": "CH3",
                            "GPIO8": "CH4",
                            "dIRefTMO": "CH5"
                        },
                        "measurements": {
                            "102": {
                                "channel": "CH1",
                                "vertical": {
                                    "scale": 0.5,
                                    "coupling": "DC"
                                },
                                "screenshot": {
                                    "output_path": "lab/results/sim_TOP_cosim_python_A1.png",
                                    "ink_saver": true
                                }
                            }
                        }
                    }
                }
            },
            "ate": {
                "components": {
                    "TESTER": {
                        "id": "ACCOTEST_STS8200",
                        "connection": {
                            "aVdd": [
                                "V0",
                                "A0"
                            ],
                            "GPIO8": "A1",
                            "TMIRefOn": "D1",
                            "TMIRefMeas": "D2",
                            "dIRefTMO": "D3",
                            "aVss": [
                                "GND0",
                                "GND1",
                                "GND2",
                                "GND3",
                                "GND4",
                                "GND5"
                            ]
                        },
                        "measurements": {
                            "103": {
                                "func_index": 7,
                                "param_name": "GPIO8_IREF_TRIM",
                                "resource_type": "FOVI",
                                "mode": "FV",
                                "force_value": 0,
                                "vrange": "FOVI_2V",
                                "irange": "FOVI_10UA",
                                "relay": "RELAY_ON",
                                "measure": {
                                    "sample_count": 20,
                                    "sample_period_us": 10,
                                    "ret_type": "MIRET",
                                    "sample_select": "AVERAGE_RESULT"
                                }
                            }
                        }
                    },
                    "SCOPE0": {
                        "id": "MSO24",
                        "connection": {
                            "aVdd": "CH1",
                            "GPIO8": "CH2",
                            "dIRefTMO": "CH3",
                            "TMIRefMeas": "CH4"
                        },
                        "measurements": {
                            "102": {
                                "channel": "CH1",
                                "vertical": {
                                    "scale": 0.5,
                                    "coupling": "DC"
                                },
                                "waveform": {
                                    "source": "CH1",
                                    "encoding": "ASCII",
                                    "start": 1,
                                    "stop": 2500,
                                    "synced": true
                                }
                            }
                        }
                    }
                }
            }
        },
        "setup": {
            "steps": [
                {
                    "id": "init",
                    "time": {
                        "value": 0,
                        "related": null
                    },
                    "actions": {
                        "V_VDD": {
                            "type": "voltage_source",
                            "voltage": 0,
                            "current_limiting": "150m",
                            "connection": "aVdd"
                        },
                        "0": {
                            "type": "ground",
                            "connection": "aVss"
                        },
                        "V_TM_ON": {
                            "type": "voltage_source",
                            "voltage": 0,
                            "connection": "TMIRefOn"
                        },
                        "V_TM_MEAS": {
                            "type": "voltage_source",
                            "voltage": 0,
                            "connection": "TMIRefMeas"
                        },
                        "D_TRIM": {
                            "type": "digital_source",
                            "value": 0,
                            "connection": "NvTrmIref"
                        }
                    }
                },
                {
                    "id": "power_up",
                    "time": {
                        "value": "100u",
                        "related": null
                    },
                    "actions": {
                        "V_VDD": {
                            "type": "voltage_source",
                            "voltage": 3.3,
                            "current_limiting": "150m",
                            "connection": "aVdd"
                        }
                    }
                },
                {
                    "id": "enable_iref_trim_mode",
                    "time": {
                        "value": "390u",
                        "related": null
                    },
                    "actions": {
                        "V_TM_ON": {
                            "type": "voltage_source",
                            "voltage": 3.3,
                            "connection": "TMIRefOn"
                        }
                    }
                },
                {
                    "id": "force_calibration_current",
                    "time": {
                        "value": "400u",
                        "related": null
                    },
                    "actions": {
                        "I_ISAR": {
                            "type": "current_source",
                            "current": "2u",
                            "voltage": 3.3,
                            "connection": "GPIO8"
                        }
                    }
                },
                {
                    "id": "sar_calibration_search",
                    "time": {
                        "value": "500u",
                        "related": null
                    },
                    "actions": {
                        "101": {
                            "type": "measure",
                            "connection": "dIRefTMO",
                            "capability": "digital_measurement",
                            "test_item_id": 101,
                            "name": "Sample comparator output dIRefTMO for Python SAR successive approximation",
                            "measure": {
                                "metric": "CMP_OUT",
                                "unit": "V"
                            },
                            "conditions": {
                                "vdd": 3.3,
                                "temp_c": 25
                            }
                        }
                    }
                },
                {
                    "id": "enable_iref_measure_mode",
                    "time": {
                        "value": "1.41m",
                        "related": null
                    },
                    "actions": {
                        "V_TM_ON": {
                            "type": "voltage_source",
                            "voltage": 0,
                            "connection": "TMIRefOn"
                        },
                        "V_TM_MEAS": {
                            "type": "voltage_source",
                            "voltage": 3.3,
                            "connection": "TMIRefMeas"
                        },
                        "V_SENSE_GND": {
                            "type": "voltage_source",
                            "voltage": 0,
                            "connection": "GPIO8"
                        }
                    }
                },
                {
                    "id": "measure_trimmed_iref",
                    "time": {
                        "value": "1.6m",
                        "related": null
                    },
                    "actions": {
                        "103": {
                            "type": "measure",
                            "connection": "GPIO8",
                            "capability": "current_measurement",
                            "test_item_id": 103,
                            "name": "Measure trimmed reference current on GPIO8",
                            "measure": {
                                "metric": "IREF",
                                "unit": "uA"
                            },
                            "conditions": {
                                "vdd": 3.3,
                                "temp_c": 25
                            },
                            "limits": {
                                "lower": 0.9,
                                "upper": 1.1
                            }
                        }
                    }
                },
                {
                    "id": "capture_full_waveform",
                    "time": {
                        "value": "2.0m",
                        "related": null
                    },
                    "actions": {
                        "102": {
                            "type": "measure",
                            "connection": "aVdd",
                            "capability": "waveform_measurement",
                            "test_item_id": 102,
                            "name": "Capture transient simulation waveform",
                            "measure": {
                                "kind": "waveform"
                            },
                            "conditions": {
                                "vdd": 3.3,
                                "temp_c": 25
                            }
                        }
                    }
                }
            ]
        }
    }
}