                                "display": "I(GPIO8)",
                                "color": "blue",
                                "thickness": "thick",
                                "stripNumber": 2
                            }
                        ]
                    }
                ],
                "closeAfterCapture": false,
                "capture": {
                    "enable": true,
                    "filename": "cosim_waveform.png"
                }
            }
