{
    "$schema": "../../../schema/waveform.schema.json",
    "version": 1.0,
    "release": "2026/08/21",
    "author": "Antigravity",
    "debugMode": true,
    "waveform": {
        "type": "viva",
        "imageSavePath": "/home/lary/simulation/BVU025/BVU025A/sim_TOP_cosim_python_A1/images",
        "database": {
            "sim_TOP_cosim_python_A1": {
                "file": "/home/lary/simulation/BVU025/BVU025A/sim_TOP_cosim_python_A1/psf"
            }
        },
        "imageSettings": {
            "resolution": 100,
            "width": 1600,
            "height": 900,
            "backgroundColor": "white"
        },
        "plot": [
            {
                "enable": true,
                "results": [
                    {
